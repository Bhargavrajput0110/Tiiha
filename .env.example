# Shiprocket API Credentials (get from Shiprocket dashboard → Settings → API)
SHIPROCKET_EMAIL=your-shiprocket@email.com
SHIPROCKET_PASSWORD=your-shiprocket-password

# Razorpay API Credentials (get from Razorpay dashboard → Settings → API Keys)
# Key ID starts with rzp_live_ (live) or rzp_test_ (test mode)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY_HERE

# Frontend URL for CORS (your deployed domain)
FRONTEND_URL=https://tiiha.in

# Port for the backend server
PORT=3000

# Supabase Credentials (get from Supabase → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# SMTP Email Configuration (for order confirmation emails)
# Example: Gmail, SendGrid, Brevo, AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin / Client Notifications (to receive new order alerts)
ADMIN_EMAIL=tilokanihari4@gmail.com
ADMIN_PHONE=91XXXXXXXXXX

# Meta WhatsApp Business Cloud API Settings
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_TEMPLATE_NAME=tiiha_new_order